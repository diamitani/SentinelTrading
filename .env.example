# Copy this file to ".env" for local development.
# On Vercel you don't need this: the Supabase connection already sets these.

# Supabase (real user accounts). Find both in Supabase -> Project Settings -> API.
# Leave empty to run in "preview mode" (accounts saved in your browser only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI research (server-side only, never shown in the browser)
GEMINI_API_KEY=
