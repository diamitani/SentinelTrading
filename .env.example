# Copy this file to ".env.local" for local development. Never commit real keys.
# On Vercel you don't need this file: the Supabase connection and AI Gateway
# are configured automatically.

# --- Accounts (Supabase) ---------------------------------------------------
# Find both in Supabase -> Project Settings -> API.
# Leave empty to run in "preview mode" (accounts saved in your browser only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- AI ----------------------------------------------------------------------
# Vercel AI Gateway key: needed ONLY when running locally.
# On Vercel the Gateway authenticates automatically, no variable needed.
AI_GATEWAY_API_KEY=

# Optional: model used for live AI (Gateway "provider/model" id).
AI_MODEL=google/gemini-3-flash

# Users bring their OWN Gemini key inside the app (AI key button).
# Do not put a shared Gemini key here.
