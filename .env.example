# Copy to .env.local for local development. Never commit real keys.

# Vercel AI Gateway key -- needed ONLY when running locally.
# On Vercel the Gateway authenticates automatically, no variable needed.
AI_GATEWAY_API_KEY=

# Optional: model used for live AI (Gateway "provider/model" id).
AI_MODEL=google/gemini-3-flash

# Users bring their OWN Gemini key inside the app (AI Key button).
# Do not put a shared Gemini key here.
